rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidStringList(listVal, maxItems) {
      return listVal is list &&
             listVal.size() <= maxItems &&
             (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.financialSafetyScore is int && data.financialSafetyScore >= 0 && data.financialSafetyScore <= 100 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650 &&
             isValidStringList(data.completedLessonIds, 50) &&
             isValidStringList(data.completedQuizIds, 50) &&
             isValidStringList(data.earnedBadgeIds, 50) &&
             data.selectedLanguage in ['ENGLISH', 'KANNADA', 'HINDI'] &&
             data.preferredTheme in ['LIGHT', 'DARK_NEON', 'SYSTEM'] &&
             data.simpleMode is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidExpense(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.category in ['HOUSEHOLD', 'FOOD', 'TRANSPORT', 'EDUCATION', 'HEALTHCARE', 'BILLS', 'SHOPPING', 'OTHER'] &&
             (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000 &&
             data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.dateMillis is int && data.dateMillis > 0 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidBudget(data, userId, monthKey) {
      return data.userId == userId &&
             data.monthKey == monthKey &&
             data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
             (data.monthlyIncome is int || data.monthlyIncome is float) && data.monthlyIncome >= 0 && data.monthlyIncome <= 100000000 &&
             (data.householdLimit is int || data.householdLimit is float) && data.householdLimit >= 0 && data.householdLimit <= 100000000 &&
             (data.foodLimit is int || data.foodLimit is float) && data.foodLimit >= 0 && data.foodLimit <= 100000000 &&
             (data.transportLimit is int || data.transportLimit is float) && data.transportLimit >= 0 && data.transportLimit <= 100000000 &&
             (data.educationLimit is int || data.educationLimit is float) && data.educationLimit >= 0 && data.educationLimit <= 100000000 &&
             (data.healthcareLimit is int || data.healthcareLimit is float) && data.healthcareLimit >= 0 && data.healthcareLimit <= 100000000 &&
             (data.billsLimit is int || data.billsLimit is float) && data.billsLimit >= 0 && data.billsLimit <= 100000000 &&
             (data.shoppingLimit is int || data.shoppingLimit is float) && data.shoppingLimit >= 0 && data.shoppingLimit <= 100000000 &&
             (data.otherLimit is int || data.otherLimit is float) && data.otherLimit >= 0 && data.otherLimit <= 100000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSavingsGoal(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             (data.targetAmount is int || data.targetAmount is float) && data.targetAmount > 0 && data.targetAmount <= 100000000 &&
             (data.savedAmount is int || data.savedAmount is float) && data.savedAmount >= 0 && data.savedAmount <= 100000000 &&
             data.targetDateMillis is int && data.targetDateMillis > 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidScanHistory(data, userId) {
      return data.userId == userId &&
             data.scanType in ['LINK', 'MESSAGE', 'CALL', 'SCREENSHOT'] &&
             data.inputPreview is string && data.inputPreview.size() >= 1 && data.inputPreview.size() <= 160 &&
             data.verdict in ['GREEN', 'YELLOW', 'RED', 'GREY'] &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
             isValidStringList(data.reasons, 10) &&
             data.reported is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTrustedContact(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.relationship is string && data.relationship.size() >= 1 && data.relationship.size() <= 40 &&
             data.phoneNumber is string && data.phoneNumber.size() >= 5 && data.phoneNumber.size() <= 20 &&
             data.consentGranted is bool &&
             data.revoked is bool &&
             data.sharedAlertsCount is int && data.sharedAlertsCount >= 0 && data.sharedAlertsCount <= 100000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidIncidentReport(data, userId) {
      return data.userId == userId &&
             data.incidentDate is string && data.incidentDate.size() >= 1 && data.incidentDate.size() <= 30 &&
             data.approximateTime is string && data.approximateTime.size() >= 1 && data.approximateTime.size() <= 30 &&
             (data.amount is int || data.amount is float) && data.amount >= 0 && data.amount <= 100000000 &&
             data.referenceId is string && data.referenceId.size() <= 80 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             (!('evidenceSummary' in data) || (data.evidenceSummary is string && data.evidenceSummary.size() <= 500)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidQuizResult(data, userId) {
      return data.userId == userId &&
             data.quizId is string && data.quizId.size() >= 1 && data.quizId.size() <= 60 &&
             data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 100 &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.totalQuestions is int && data.totalQuestions > 0 && data.totalQuestions <= 100 &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'financialSafetyScore', 'streakDays',
                         'completedLessonIds', 'completedQuizIds', 'earnedBadgeIds',
                         'selectedLanguage', 'preferredTheme', 'simpleMode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'financialSafetyScore', 'streakDays',
                         'completedLessonIds', 'completedQuizIds', 'earnedBadgeIds',
                         'selectedLanguage', 'preferredTheme', 'simpleMode', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'financialSafetyScore', 'streakDays',
                         'completedLessonIds', 'completedQuizIds', 'earnedBadgeIds',
                         'selectedLanguage', 'preferredTheme', 'simpleMode', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(expenseId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         incoming().keys().hasAll(['userId', 'title', 'category', 'amount', 'monthKey', 'dateMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'category', 'amount', 'monthKey', 'dateMillis', 'note', 'createdAt', 'updatedAt']) &&
                         isValidExpense(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(expenseId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidExpense(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amount', 'monthKey', 'dateMillis', 'note', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /budgets/{monthKey} {
        allow get: if isOwner(userId) && isValidId(monthKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(monthKey) &&
                         incoming().keys().hasAll([
                           'userId', 'monthKey', 'monthlyIncome', 'householdLimit', 'foodLimit',
                           'transportLimit', 'educationLimit', 'healthcareLimit', 'billsLimit',
                           'shoppingLimit', 'otherLimit', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'monthKey', 'monthlyIncome', 'householdLimit', 'foodLimit',
                           'transportLimit', 'educationLimit', 'healthcareLimit', 'billsLimit',
                           'shoppingLimit', 'otherLimit', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidBudget(incoming(), userId, monthKey);

        allow update: if isOwner(userId) &&
                         isValidId(monthKey) &&
                         incoming().userId == existing().userId &&
                         incoming().monthKey == existing().monthKey &&
                         incoming().createdAt == existing().createdAt &&
                         isValidBudget(incoming(), userId, monthKey) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'monthlyIncome', 'householdLimit', 'foodLimit', 'transportLimit',
                           'educationLimit', 'healthcareLimit', 'billsLimit', 'shoppingLimit',
                           'otherLimit', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(monthKey);
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll(['userId', 'title', 'category', 'targetAmount', 'savedAmount', 'targetDateMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'category', 'targetAmount', 'savedAmount', 'targetDateMillis', 'createdAt', 'updatedAt']) &&
                         isValidSavingsGoal(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSavingsGoal(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'targetAmount', 'savedAmount', 'targetDateMillis', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      match /scanHistory/{scanId} {
        allow get: if isOwner(userId) && isValidId(scanId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(scanId) &&
                         incoming().keys().hasAll(['userId', 'scanType', 'inputPreview', 'verdict', 'summary', 'reasons', 'reported', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'scanType', 'inputPreview', 'verdict', 'summary', 'reasons', 'reported', 'createdAt', 'updatedAt']) &&
                         isValidScanHistory(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(scanId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidScanHistory(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['reported', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(scanId);
      }

      match /trustedContacts/{contactId} {
        allow get: if isOwner(userId) && isValidId(contactId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(contactId) &&
                         incoming().keys().hasAll(['userId', 'name', 'relationship', 'phoneNumber', 'consentGranted', 'revoked', 'sharedAlertsCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'relationship', 'phoneNumber', 'consentGranted', 'revoked', 'sharedAlertsCount', 'createdAt', 'updatedAt']) &&
                         isValidTrustedContact(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(contactId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTrustedContact(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'relationship', 'phoneNumber', 'consentGranted', 'revoked', 'sharedAlertsCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(contactId);
      }

      match /incidentReports/{reportId} {
        allow get: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(reportId) &&
                         incoming().keys().hasAll(['userId', 'incidentDate', 'approximateTime', 'amount', 'referenceId', 'paymentMethod', 'description', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'incidentDate', 'approximateTime', 'amount', 'referenceId', 'paymentMethod', 'description', 'evidenceSummary', 'createdAt', 'updatedAt']) &&
                         isValidIncidentReport(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(reportId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidIncidentReport(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['incidentDate', 'approximateTime', 'amount', 'referenceId', 'paymentMethod', 'description', 'evidenceSummary', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(reportId);
      }

      match /quizResults/{resultId} {
        allow get: if isOwner(userId) && isValidId(resultId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(resultId) &&
                         incoming().keys().hasAll(['userId', 'quizId', 'quizTitle', 'score', 'totalQuestions', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'quizId', 'quizTitle', 'score', 'totalQuestions', 'createdAt']) &&
                         isValidQuizResult(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(resultId);
      }
    }
  }
}
